# Documentation only; this starter does not automatically load .env files.
# Set these values in the terminal before starting the application.
VICTUS_DATA_DIR=
VICTUS_API_TOKEN=
# Optional development-only allowlist; set explicitly in the terminal to enable.
# VICTUS_DASHBOARD_DEV_ORIGIN=http://127.0.0.1:5173

# Optional: existing downloaded faster-whisper CTranslate2 directory. No download is attempted.
# VICTUS_VOICE_MODEL_PATH=C:/local-models/faster-whisper-base.en

# M8 optional features are disabled by default. No assets are downloaded at boot.
# VICTUS_WAKE_MANIFEST_PATH=C:/VICTUS-assets/wake/reviewed-qualification.json
# VICTUS_MCP_NOTES=1
# Set both to enable the separate, explicitly reviewed cloud panel:
# VICTUS_CLOUD_MODEL=provider/model-id
# VICTUS_CLOUD_UPSTREAM=explicit-upstream-provider
# Store the key with the Windows credential adapter; never put a key here.
