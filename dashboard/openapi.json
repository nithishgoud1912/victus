  "components": {
    "schemas": {
      "ActionRequest": {
        "properties": {
          "tool": {
            "type": "string",
            "const": "fs.create_note",
            "title": "Tool"
          },
          "arguments": {
            "$ref": "#/components/schemas/NoteArguments"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "tool",
          "arguments"
        ],
        "title": "ActionRequest"
      },
      "ApprovalRecord": {
        "properties": {
          "task_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Task Id"
          },
          "action_id": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Action Id"
          },
          "tool_name": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Tool Name"
          },
          "tool_version": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Tool Version"
          },
          "canonical_args_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "title": "Canonical Args Hash"
          },
          "policy_version": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Policy Version"
          },
          "target_identity": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Target Identity"
          },
          "observation_identity": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Observation Identity"
          },
          "approval_id": {
            "type": "string",
            "title": "Approval Id"
          },
          "preview_ref": {
            "type": "string",
            "title": "Preview Ref"
          },
          "expires_at": {
            "type": "number",
            "title": "Expires At"
          },
          "state": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "denied",
              "expired",
              "invalidated",
              "consumed"
            ],
            "title": "State"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "updated_at": {
            "type": "number",
            "title": "Updated At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task_id",
          "action_id",
          "tool_name",
          "tool_version",
          "canonical_args_hash",
          "policy_version",
          "target_identity",
          "observation_identity",
          "approval_id",
          "preview_ref",
          "expires_at",
          "state",
          "created_at",
          "updated_at"
        ],
        "title": "ApprovalRecord"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "mode": {
            "type": "string",
            "title": "Mode"
          },
          "stopped": {
            "type": "boolean",
            "title": "Stopped"
          },
          "emergency_hotkey": {
            "type": "string",
            "title": "Emergency Hotkey"
          },
          "tools": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Tools"
          }
        },
        "type": "object",
        "required": [
          "status",
          "mode",
          "stopped",
          "emergency_hotkey",
          "tools"
        ],
        "title": "HealthResponse"
      },
      "NoteArguments": {
        "properties": {
          "filename": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}\\.txt$",
            "title": "Filename"
          },
          "text": {
            "type": "string",
            "maxLength": 8192,
            "minLength": 1,
            "title": "Text"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "filename",
          "text"
        ],
        "title": "NoteArguments"
      },
      "Resolution": {
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "approved",
              "denied"
            ],
            "title": "Decision"
          },
          "confirmation": {
            "type": "string",
            "const": "explicit_user_review",
            "title": "Confirmation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "decision",
          "confirmation"
        ],
        "title": "Resolution"
      },
      "SessionStatus": {
        "properties": {
          "authenticated": {
            "type": "boolean",
            "title": "Authenticated"
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expires At"
          }
        },
        "type": "object",
        "required": [
          "authenticated",
          "expires_at"
        ],
        "title": "SessionStatus"
      },
      "StopResponse": {
        "properties": {
          "stopped": {
            "type": "boolean",
            "title": "Stopped"
          },
          "reset": {
            "type": "string",
            "title": "Reset"
          }
        },
        "type": "object",
        "required": [
          "stopped",
          "reset"
        ],
        "title": "StopResponse"
      },
      "TaskQueuedResponse": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "cancelled"
            ],
            "title": "Status",
            "default": "queued"
          }
        },
        "type": "object",
        "required": [
          "task_id"
        ],
        "title": "TaskQueuedResponse"
      },
      "TaskResult": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "tool": {
            "type": "string",
            "title": "Tool"
          },
          "action_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "prepared",
              "running",
              "succeeded",
              "failed",
              "cancelled",
              "unknown"
            ],
            "title": "Status"
          },
          "verified": {
            "type": "boolean",
            "title": "Verified",
            "default": false
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "output_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Name"
          },
          "sha256": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Sha256"
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "tool",
          "status"
        ],
        "title": "TaskResult"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      },
      "APIKeyCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "victus_session"
      }
    }
  }
}
